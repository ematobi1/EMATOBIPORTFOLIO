# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio

# JWT signing key (required in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=

# Admin account created on first startup if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Optional: SMTP for contact-form notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
